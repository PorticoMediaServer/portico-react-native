{
  "name": "portico-react-native",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "verify:build-contract": "node scripts/verify-build-contract.mjs",
    "verify:apple-native-source": "node scripts/verify-apple-native-source.cjs",
    "verify:product-copy": "node scripts/verify-product-copy.cjs",
    "acceptance:native": "node scripts/acceptance/run-native-acceptance.mjs --json",
    "pretypecheck": "npm run verify:build-contract && npm run verify:product-copy && npm run verify:apple-native-source",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint apps packages --ext .js,.jsx,.ts,.tsx",
    "pretest": "npm run verify:build-contract && npm run verify:product-copy && npm run verify:apple-native-source",
    "test": "jest --config jest.config.js --runInBand",
    "start:ios": "npm --workspace @portico-react-native/apple-mobile run start",
    "start:tvos": "npm --workspace @portico-react-native/apple-tv run start",
    "ios": "npm --workspace @portico-react-native/apple-mobile run ios",
    "tvos": "npm --workspace @portico-react-native/apple-tv run ios"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.28.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "3.8.1",
    "react": "19.2.7",
    "react-test-renderer": "19.2.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react-native-screens": "4.19.0"
  },
  "overrides": {
    "metro": "0.83.8",
    "metro-config": "0.83.8",
    "metro-transform-worker": "0.83.8"
  }
}
