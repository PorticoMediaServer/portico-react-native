<?xml version="1.0" encoding="utf-8"?>
<!-- A Portico server may be reached over plain HTTP at any address its owner gives out, at home
     or away (its identity is verified by its pinned key, not by a certificate). TLS connections
     are checked against the system's trust store; routes a Portico Account hands out are always
     TLS. The app pins no public certificate authority and trusts no user-installed one. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
