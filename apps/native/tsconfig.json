{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "react"
    ],
    "strict": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "ios/Pods",
    "tvos/Pods",
    "test"
  ]
}
