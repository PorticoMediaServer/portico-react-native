{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["react"],
    "strict": true,
    "baseUrl": ".",
    // The shared sources have no node_modules of their own here: every package they import is
    // named, and resolves to what Metro gives them (metro.config.js).
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-native": ["./src/shims/react-native.ts"],
      "@react-navigation/native": ["./node_modules/@amazon-devices/react-navigation__native"],
      "@react-navigation/native-stack": ["./node_modules/@amazon-devices/react-navigation__native-stack"],
      "react-native-safe-area-context": ["./node_modules/@amazon-devices/react-native-safe-area-context"],
      "react-native-reanimated": ["./src/shims/reanimated.tsx"],
      "react-native-svg": ["./node_modules/@amazon-devices/react-native-svg"],
      "react-native-qrcode-svg": ["./node_modules/react-native-qrcode-svg"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "types/**/*.d.ts", "../native/App.tsx", "../native/src/**/*.ts", "../native/src/**/*.tsx"],
  "exclude": ["node_modules", "build"]
}
